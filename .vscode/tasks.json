{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Quality Gate: Check All",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/check.ps1",
            "windows": {
                "command": "${workspaceFolder}\\scripts\\check.ps1"
            },
            "linux": {
                "command": "pwsh ${workspaceFolder}/scripts/check.ps1"
            },
            "osx": {
                "command": "pwsh ${workspaceFolder}/scripts/check.ps1"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Quality Gate: Auto-Fix",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/fix.ps1",
            "windows": {
                "command": "${workspaceFolder}\\scripts\\fix.ps1"
            },
            "linux": {
                "command": "pwsh ${workspaceFolder}/scripts/fix.ps1"
            },
            "osx": {
                "command": "pwsh ${workspaceFolder}/scripts/fix.ps1"
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Run Tests",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["-m", "pytest", "tests/", "-v"],
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
            },
            "linux": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": ["-m", "pytest", "tests/", "-v"]
            },
            "osx": {
                "command": "${workspaceFolder}/.venv/bin/python",
                "args": ["-m", "pytest", "tests/", "-v"]
            },
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Ruff: Lint",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/ruff.exe",
            "args": ["check", "."],
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\ruff.exe"
            },
            "linux": {
                "command": "${workspaceFolder}/.venv/bin/ruff",
                "args": ["check", "."]
            },
            "osx": {
                "command": "${workspaceFolder}/.venv/bin/ruff",
                "args": ["check", "."]
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Ruff: Format",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/ruff.exe",
            "args": ["format", "."],
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\ruff.exe"
            },
            "linux": {
                "command": "${workspaceFolder}/.venv/bin/ruff",
                "args": ["format", "."]
            },
            "osx": {
                "command": "${workspaceFolder}/.venv/bin/ruff",
                "args": ["format", "."]
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Bootstrap: Setup Project",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/bootstrap.ps1",
            "args": ["-SetupVenv", "-NonInteractive"],
            "windows": {
                "command": "${workspaceFolder}\\scripts\\bootstrap.ps1"
            },
            "linux": {
                "command": "pwsh ${workspaceFolder}/scripts/bootstrap.ps1"
            },
            "osx": {
                "command": "pwsh ${workspaceFolder}/scripts/bootstrap.ps1"
            },
            "group": "none",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        }
    ]
}
